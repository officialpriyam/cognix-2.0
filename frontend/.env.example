# Frontend Environment Variables
# Used by: frontend/ application

# Backend API URL
# For local development: http://localhost:3001
# For production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Allowed CORS origins (comma-separated)
# Frontend URL that the backend will accept requests from
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000

# Authentication URL
# Where the backend authentication is hosted
BETTER_AUTH_URL=http://localhost:3001

# Better Auth secret (server-rendered pages instantiate Better Auth server-side)
# Generate with: npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=

# Database (Supabase)
# Server components (agents, workflows, archives, MCP pages, exports) read Postgres directly.
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" URI (port 5432) and append ?sslmode=require (Supabase requires TLS):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_URL=

# Redis (Upstash, optional)
# Format (note rediss:// — Upstash only accepts TLS connections):
#   rediss://default:<password>@<your-db>.upstash.io:6379
REDIS_URL=

# Optional: Internationalization
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Optional: Analytics
NEXT_PUBLIC_ANALYTICS_ID=
