# Backend Environment Variables
# Used by: backend/ application

# Server Configuration
PORT=3001
# NOTE: Do NOT set NODE_ENV here or in your hosting dashboard.
# `next dev` / `next build` / `next start` set it themselves.
# An ambient NODE_ENV=development during `next build` bundles the development
# React build and crashes static prerendering (see docs/RENDER_DEPLOY_GUIDE.md).

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# DATABASE CONFIGURATION (Multi-Provider Support)
# ============================================================================
# 
# This application supports multiple PostgreSQL providers:
# - Supabase (serverless PostgreSQL)
# - Neon (serverless PostgreSQL)
# - Railway, Render, Heroku (managed PostgreSQL)
# - AWS RDS, Google Cloud SQL, Azure Flexible Server
# - Local PostgreSQL (development)
#
# The provider is auto-detected from the connection URL.
# Set POSTGRES_URL to your provider's connection string.
#
# ============================================================================

# --- Supabase (Recommended for this project) ---
# Create a project at https://supabase.com
# Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" URI (port 5432) with sslmode=require:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Example:
# POSTGRES_URL=postgresql://postgres.pwjyxihmqgzfqcixnxox:LoATid561lafyS9g@db.pwjyxihmqgzfqcixnxox.supabase.co:5432/postgres?sslmode=require&uselibpqcompat=true

POSTGRES_URL=

# --- Neon (Alternative Serverless PostgreSQL) ---
# Dashboard -> Project -> Connection string
# POSTGRES_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Local PostgreSQL (Development) ---
# Using Docker:
# docker run --name cognix-pg -e POSTGRES_PASSWORD=devpass -e POSTGRES_USER=postgres -e POSTGRES_DB=cognix -p 5432:5432 -d postgres:17-alpine
# POSTGRES_URL=postgresql://postgres:devpass@localhost:5432/cognix

# --- Railway / Render / Heroku (Managed PostgreSQL) ---
# These providers typically give you a DATABASE_URL or connection string
# POSTGRES_URL=postgresql://user:password@host.provider.com:5432/dbname?sslmode=require

# ============================================================================
# OPTIONAL: Database SSL Configuration
# ============================================================================
# Most cloud providers require SSL. The sslmode parameter in POSTGRES_URL
# controls this:
#   sslmode=disable     - No SSL (local dev only)
#   sslmode=require     - Require SSL (encrypts connection)
#   sslmode=verify-ca   - Verify server certificate against CA
#   sslmode=verify-full - Verify server certificate and hostname (most secure)
#
# For newer PostgreSQL versions (v9.0.0+), add uselibpqcompat=true to maintain
# current SSL behavior:
# POSTGRES_URL=...?sslmode=require&uselibpqcompat=true

# Path to SSL root certificate (optional, for verify-ca mode)
# PGSSLROOTCERT=/path/to/ca-cert.pem

# ============================================================================
# OPTIONAL: Supabase CLI Configuration
# ============================================================================
# For using Supabase CLI commands (supabase db push, etc.)
# Get a personal access token from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Supabase project reference (extract from POSTGRES_URL or set manually)
# Example: if URL is db.pwjyxihmqgzfqcixnxox.supabase.co, ref is pwjyxihmqgzfqcixnxox
SUPABASE_PROJECT_REF=

# For direct database pushes (non-Supabase providers)
# Set to 'true' to skip Supabase CLI and use Drizzle directly
# DB_PUSH_DIRECT=true

# ============================================================================
POSTGRES_URL=

# Set to 'true' to skip the automatic Drizzle migration on boot (instrumentation.ts).
# Use it when you apply the schema yourself via `pnpm db:migrate`, or when the
# database is unreachable from the app host at startup.
DISABLE_AUTO_MIGRATE=false

# Authentication (Better Auth)
# Generate with: npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=your-secret-key-here

# Better Auth URL (where users access the auth endpoints)
# For local: http://localhost:3001
# For production: https://api.yourdomain.com
BETTER_AUTH_URL=http://localhost:3001

# Redis (Upstash, optional - for caching and distributed rate limiting)
# Upstash Console -> your database -> Connect -> ioredis tab
# Use the rediss:// (TLS) URL - required by Upstash:
#   rediss://default:<password>@<your-db>.upstash.io:6379
REDIS_URL=

# === LLM Provider API Keys ===
# Add only the providers you plan to use

GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/api
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Email Configuration (optional)
# For password reset emails via Resend
RESEND_API_KEY=
PASSWORD_RESET_EMAIL_FROM=noreply@yourdomain.com

# OAuth Providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# File Storage (optional)
# Options: s3, vercel-blob
FILE_STORAGE_TYPE=s3
FILE_STORAGE_S3_BUCKET=
FILE_STORAGE_S3_REGION=
FILE_STORAGE_S3_ENDPOINT=
FILE_STORAGE_S3_FORCE_PATH_STYLE=

# AWS Credentials (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Logging (optional)
LOG_LEVEL=info
