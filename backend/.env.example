# Backend Environment Variables
# Used by: backend/ application

# Server Configuration
PORT=3001
NODE_ENV=development

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000

# Database (Supabase)
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" URI (port 5432) and append ?sslmode=require (Supabase requires TLS):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_URL=

# Authentication (Better Auth)
# Generate with: npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=your-secret-key-here

# Better Auth URL (where users access the auth endpoints)
# For local: http://localhost:3001
# For production: https://api.yourdomain.com
BETTER_AUTH_URL=http://localhost:3001

# Redis (Upstash, optional - for caching and distributed rate limiting)
# Upstash Console -> your database -> Connect -> ioredis tab
# Use the rediss:// (TLS) URL - required by Upstash:
#   rediss://default:<password>@<your-db>.upstash.io:6379
REDIS_URL=

# === LLM Provider API Keys ===
# Add only the providers you plan to use

GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/api
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Email Configuration (optional)
# For password reset emails via Resend
RESEND_API_KEY=
PASSWORD_RESET_EMAIL_FROM=noreply@yourdomain.com

# OAuth Providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# File Storage (optional)
# Options: s3, vercel-blob
FILE_STORAGE_TYPE=s3
FILE_STORAGE_S3_BUCKET=
FILE_STORAGE_S3_REGION=
FILE_STORAGE_S3_ENDPOINT=
FILE_STORAGE_S3_FORCE_PATH_STYLE=

# AWS Credentials (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Logging (optional)
LOG_LEVEL=info
